# ═══════════════════════════════════════════════════════════════════
#  NÉRÉ MINING — Configuration d'environnement
#  Copier ce fichier en .env et remplir toutes les valeurs marquées [REQUIRED]
#  NE JAMAIS versionner le fichier .env
# ═══════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────
APP_NAME="Nere Mining"
APP_ENV=production          # local | staging | production
APP_KEY=                    # [REQUIRED] Générer avec : php artisan key:generate
APP_DEBUG=false             # TOUJOURS false en production
APP_URL=https://www.nere-mining.bf  # [REQUIRED] URL complète avec https://
APP_TIMEZONE=Africa/Ouagadougou
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# HTTPS forcé (nécessaire si derrière un reverse proxy / load balancer)
FORCE_HTTPS=true

# ── Base de données ──────────────────────────────────────────────────
DB_CONNECTION=mysql         # mysql | pgsql | sqlite
DB_HOST=127.0.0.1           # [REQUIRED] Adresse du serveur MySQL
DB_PORT=3306
DB_DATABASE=nere_mining     # [REQUIRED] Nom de la base
DB_USERNAME=nere_user       # [REQUIRED] Utilisateur MySQL (PAS root)
DB_PASSWORD=                # [REQUIRED] Mot de passe fort (min 16 chars)

# ── Session ──────────────────────────────────────────────────────────
SESSION_DRIVER=file         # file (simple) | database (si multi-serveur)
SESSION_LIFETIME=120        # Minutes d'inactivité avant expiration
SESSION_ENCRYPT=true        # Chiffrer les données de session
SESSION_SECURE_COOKIE=true  # Cookies HTTPS uniquement
SESSION_SAME_SITE=strict    # Protection CSRF renforcée
SESSION_COOKIE=nm_session   # Nom neutre du cookie

# ── Cache ────────────────────────────────────────────────────────────
CACHE_STORE=file            # file | redis | database

# ── Files d'attente ──────────────────────────────────────────────────
QUEUE_CONNECTION=sync       # sync (simple) | database (si jobs asynchrones)

# ── Filesystem ───────────────────────────────────────────────────────
FILESYSTEM_DISK=public      # public (uploads dans public/uploads/)

# ── Logs ─────────────────────────────────────────────────────────────
LOG_CHANNEL=daily           # daily (un fichier par jour, rotation 30j)
LOG_LEVEL=warning           # debug | info | warning | error | critical
LOG_DAILY_DAYS=30           # Nombre de jours de rétention des logs

# ── Email (transactionnel) ───────────────────────────────────────────
MAIL_MAILER=smtp            # smtp | sendmail | log (log = debug seulement)
MAIL_HOST=                  # [REQUIRED si emails] Serveur SMTP
MAIL_PORT=587               # 587 (TLS) | 465 (SSL) | 25
MAIL_USERNAME=              # [REQUIRED si emails]
MAIL_PASSWORD=              # [REQUIRED si emails]
MAIL_ENCRYPTION=tls         # tls | ssl
MAIL_FROM_ADDRESS="noreply@nere-mining.bf"
MAIL_FROM_NAME="Néré Mining"

# ── Mode maintenance ─────────────────────────────────────────────────
# Pour activer : php artisan down --message="Maintenance en cours" --retry=300
# Pour désactiver : php artisan up
APP_MAINTENANCE_DRIVER=file
