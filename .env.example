# ═══════════════════════════════════════════════════════════════════════════
#  NÉRÉ MINING  - Configuration d'environnement PRODUCTION (serveurs de la mine)
#  Copier en .env et remplir TOUTES les valeurs [REQUIRED]
#  ⚠  NE JAMAIS versionner le fichier .env
#  ⚠  Générer une APP_KEY unique : php artisan key:generate --show
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Nere Mining"
APP_ENV=production          # TOUJOURS production sur le serveur de la mine
APP_KEY=                    # [REQUIRED] php artisan key:generate --show
APP_DEBUG=false             # TOUJOURS false en production
APP_URL=https://www.nere-mining.bf  # [REQUIRED] URL complète avec https://
APP_TIMEZONE=Africa/Ouagadougou
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
FORCE_HTTPS=true            # Activer si derrière un reverse proxy / Apache SSL
CORS_ALLOWED_ORIGINS=https://nere-mining.bf

# ── Base de données PostgreSQL locale ───────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=nere_mining_dev
DB_USERNAME=postgres
DB_PASSWORD=                # [REQUIRED] Mot de passe PostgreSQL local
DB_CHARSET=utf8

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database     # Session persistante PostgreSQL en production
SESSION_LIFETIME=120        # Minutes d'inactivité
SESSION_ENCRYPT=false       # Compatible avec le stockage PostgreSQL
SESSION_SECURE_COOKIE=true  # Cookies HTTPS uniquement (activer après SSL)
SESSION_SAME_SITE=lax       # Protection CSRF compatible avec les redirections HTTPS
SESSION_COOKIE=nm_session_v2 # Nom neutre et renouvelé après changement de session

# ── Cache & Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=file            # 'file' ou 'redis' si disponible
QUEUE_CONNECTION=database     # 'sync' ou 'database' si jobs asynchrones

# ── Filesystem uploads ────────────────────────────────────────────────────────
# Option A : Stockage local (serveur de la mine avec disque persistant)
FILESYSTEM_DISK=public      # Fichiers dans public/uploads/  - accessible directement

# Option B : Cloudflare R2 (si accès internet depuis le serveur)
# FILESYSTEM_DISK=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=nere-mining
# R2_ACCOUNT_ID=
# R2_PUBLIC_URL=

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily           # Rotation quotidienne
LOG_LEVEL=warning           # warning en prod (pas debug !)
LOG_DAILY_DAYS=30           # Rétention 30 jours

# ── Email ─────────────────────────────────────────────────────────────────────
# Destinataire des messages de contact et des candidatures : ce n'est PAS ici.
# Il se règle dans Admin > Paramètres du site > champ « hr email address ».
MAIL_MAILER=smtp
MAIL_HOST=                  # [REQUIRED si emails] Serveur SMTP
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Chiffrement : 'smtp' = STARTTLS négocié (port 587) | 'smtps' = TLS implicite (port 465)
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="noreply@nere-mining.bf"
MAIL_FROM_NAME="Néré Mining"

# Timeout de connexion SMTP, en secondes. Évite qu'un serveur SMTP lent
# fasse expirer la requête (erreur 502 sur le formulaire de contact).
MAIL_SMTP_TIMEOUT=10

# ── File d'attente (obligatoire pour découpler l'envoi du formulaire) ──────────
# 'sync' = le mail part pendant la requête (risque de 502)
# 'database' = le mail part en tâche de fond via `php artisan queue:work`
# ⚠ Réglage défini plus haut (section « Cache & Queue »). Ne pas dupliquer.

# ── Analytics / consentement ────────────────────────────────────────────────
GA_MEASUREMENT_ID="G-K1QQ6E195H" # Google Analytics 4 (G-XXXXXXXXXX). Non secret.
GA_ENABLED=true                      # false = plus aucune collecte, sans toucher à l'ID

# ── Sécurité supplémentaire ───────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
