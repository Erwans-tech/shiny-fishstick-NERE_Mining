# 🚀 Configuration Railway — À remplir dans Railway dashboard

# ── Application ─────────────────────────────────────────
APP_NAME="Néré Mining"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votre-domaine.railway.app
FORCE_HTTPS=true

# ── Database (Railroad utilisera ces variables) ─────────
# Railway injecte automatiquement : DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD
# Décommenter et mettre à jour si besoin
# DB_CONNECTION=mysql
# DB_HOST=mysql.railway.internal
# DB_PORT=3306
# DB_DATABASE=railway
# DB_USERNAME=root
# DB_PASSWORD=

# ── Session ─────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# ── Filesystem ──────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Logs ────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
