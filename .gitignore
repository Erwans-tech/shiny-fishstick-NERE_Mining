# Les médias publics uploadés font partie du déploiement Git.
# Include essential uploads for production
!/public/uploads/
!/public/uploads/**/*.jpg
!/public/uploads/**/*.jpeg  
!/public/uploads/**/*.png
!/public/uploads/**/*.gif
!/public/uploads/**/*.webp
!/public/uploads/**/*.svg
/bootstrap/cache

# Render specific
render.yaml.local

# Production database (SQLite - versioned in Git)
!database/production.sqlite

# ── Secrets : ne jamais commiter ─────────────────────────
# Fichiers d'environnement réels (APP_KEY, mots de passe de BDD, admin)
.env
.env.*
!.env.example
!.env.render.example

# Dumps d'environnement d'infrastructure
/clean_production_env.txt
/env_windows_server.txt

