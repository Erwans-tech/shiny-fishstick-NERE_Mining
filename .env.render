# 🎯 Configuration Render + Supabase pour Néré Mining
# Ce fichier sert de template - les vraies valeurs sont dans le dashboard Render

# ── Application ─────────────────────────────────────────
APP_NAME="Néré Mining"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:7UZXohTuPEpD8/s9/ILFmz8kYqFX28WXzaeAFwnQ0jQ=
APP_URL=https://nere-mining-ex3a.onrender.com
FORCE_HTTPS=true

# ── Database SQLite for Production (embedded in Git) ──────────────────────────────
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/production.sqlite
# Supabase disabled - using SQLite instead
# DB_CONNECTION=pgsql
# DB_HOST=db.plibklblcykfhnoboqum.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=4kuAbwAFxDb1nD03

# ── Session ─────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Cache ───────────────────────────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ── Filesystem ──────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Logs ────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Mail ────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sécurité ────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Admin par défaut ────────────────────────────────────
ADMIN_EMAIL=admin@nere-mining.com
ADMIN_PASSWORD=NereAdmin2024!

# ── Optionnel : Supabase Auth & Storage ─────────────────
# Si tu veux utiliser l'auth Supabase ou le storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key