# Git LFS Configuration for Néré Mining
# Rules are processed top-to-bottom, most specific first

# Gallery images - EXCLUDED from Git LFS (normal git tracking)
public/uploads/gallery/*.jpg -filter -diff -merge
public/uploads/gallery/*.jpeg -filter -diff -merge
public/uploads/gallery/*.webp -filter -diff -merge

# Other uploads - Git LFS
public/uploads/**/*.jpg filter=lfs diff=lfs merge=lfs -text
public/uploads/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/uploads/**/*.png filter=lfs diff=lfs merge=lfs -text
public/uploads/**/*.webp filter=lfs diff=lfs merge=lfs -text
public/uploads/**/*.pdf filter=lfs diff=lfs merge=lfs -text
public/uploads/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
public/uploads/**/*.svg filter=lfs diff=lfs merge=lfs -text

# Public images - Git LFS
public/images/* filter=lfs diff=lfs merge=lfs -text
public/images/hero/*.jpg filter=lfs diff=lfs merge=lfs -text
public/images/leadership/*.jpg filter=lfs diff=lfs merge=lfs -text
public/images/news/*.jpg filter=lfs diff=lfs merge=lfs -text
public/images/news/*.png filter=lfs diff=lfs merge=lfs -text
public/images/partners/*.jpg filter=lfs diff=lfs merge=lfs -text
public/images/news/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/images/partners/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/images/partners/*.png filter=lfs diff=lfs merge=lfs -text

# Database snapshots - Git LFS
database/local-content.sql filter=lfs diff=lfs merge=lfs -text
