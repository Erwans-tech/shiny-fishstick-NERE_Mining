# 🎯 Configuration Render avec PostgreSQL interne
#
# ⚠️  NE JAMAIS COMMITER LE FICHIER .env.render RÉEL.
#     Copier ce template :  cp .env.render.example .env.render
#     Les secrets se déclarent dans le dashboard Render (render.yaml utilise `sync: false`).

# ── Application ─────────────────────────────────────────
APP_NAME="Néré Mining"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://nere-mining-ex3a.onrender.com
FORCE_HTTPS=true

# ── Database PostgreSQL interne Render ─────────────────────────────
# Récupérable dans le dashboard Render > PostgreSQL > Connection
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Session ─────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Cache / File d'attente ───────────────────────────────
CACHE_DRIVER=file
# 'database' : les e-mails partent en tâche de fond via le worker Render.
#              'sync' ferait expirer la requête si le SMTP est lent (erreur 502).
QUEUE_CONNECTION=database

# ── Filesystem ──────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Analytics ───────────────────────────────────────────
# L'ID de mesure est public : il apparaît dans le HTML envoyé au navigateur.
GA_MEASUREMENT_ID="G-K1QQ6E195H"
GA_ENABLED=true

# ── Logs ────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Mail ────────────────────────────────────────────────
# Destinataire des messages de contact et candidatures : PAS ici.
# Il se règle dans Admin > Paramètres du site > champ « hr email address ».
MAIL_MAILER=smtp
MAIL_HOST=                  # ex. ssl0.ovh.net (OVHcloud) ou mail.tonweb.ovh.net
MAIL_PORT=465               # 465 = TLS implicite, 587 = STARTTLS
MAIL_USERNAME=              # adresse complète de la boîte OVH expéditrice
MAIL_PASSWORD=
MAIL_SCHEME=smtps           # 'smtps' sur 465, 'smtp' sur 587
MAIL_FROM_ADDRESS=          # doit appartenir au domaine, sinon rejet SPF/DMARC
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SMTP_TIMEOUT=10

# ── Sécurité ────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Admin par défaut ────────────────────────────────────
# Générer un mot de passe fort : openssl rand -base64 24
ADMIN_EMAIL=admin@nere-mining.com
ADMIN_PASSWORD=

# ── Optionnel : Supabase Auth & Storage ─────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
